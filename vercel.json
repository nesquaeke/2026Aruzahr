{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix web ci --no-audit --no-fund",
  "buildCommand": "npm --prefix web run assets && npm --prefix web run build",
  "outputDirectory": "web/dist",
  "headers": [
    {
      "source": "/rules/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
